APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///cards.db
# Required in production. Use comma-separated deployed hostnames.
# TRUSTED_HOSTS=cards.example.com,staging.cards.example.com
PUBLIC_REGISTRATION_ENABLED=true
# Keep one worker until rate limits use a shared store.
WEB_CONCURRENCY=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
MAX_CONTENT_LENGTH=2097152
SESSION_LIFETIME_DAYS=7
# Password reset email delivery
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=
# Optional public base URL for links included in reset emails.
PASSWORD_RESET_URL_BASE=
PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=3600
QUIZ_ATTEMPT_MAX_AGE_SECONDS=7200
MAX_ACTIVE_QUIZ_ATTEMPTS=5
MAX_QUIZ_QUESTIONS=50
