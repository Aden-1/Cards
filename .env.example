APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///cards.db
# Development SQLite files are upgraded automatically on app startup. Set this
# to false only when you need to inspect an intentionally old local schema.
AUTO_MIGRATE_LOCAL=true
# Required in production. Use comma-separated deployed hostnames.
# TRUSTED_HOSTS=cards.example.com,staging.cards.example.com
PUBLIC_REGISTRATION_ENABLED=true
# Optional Sentry error tracking. Set the DSN only in an environment where
# outbound telemetry has been approved; the application filters credentials,
# tokens, email addresses, and request cookies before sending events.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0
RELEASE_VERSION=
# Production requires a shared Redis backend. Development and tests default to memory://.
# RATELIMIT_STORAGE_URI=rediss://default:password@redis.example.com:6379/0
RATELIMIT_KEY_PREFIX=cards
# Set to the number of directly-connected, trusted proxy hops. Set 1 on Heroku.
# Leave at 0 for direct/local deployments; X-Forwarded-* headers are then ignored.
TRUST_PROXY_HOPS=0
RATE_LIMIT_LOGIN=10 per 15 minutes
RATE_LIMIT_REGISTER=5 per hour
RATE_LIMIT_FORGOT_PASSWORD=5 per hour
RATE_LIMIT_RESET_PASSWORD=10 per hour
RATE_LIMIT_ACCOUNT=10 per hour
RATE_LIMIT_DELETE_ACCOUNT=3 per hour
RATE_LIMIT_ADMIN_USERS=30 per hour
RATE_LIMIT_START_QUIZ=10 per minute
RATE_LIMIT_SEARCH=60 per minute
RATE_LIMIT_IMPORT_DECK=10 per hour
RATE_LIMIT_PUBLIC_COPY=20 per hour
RATE_LIMIT_CONTENT_MUTATION=120 per hour
RATE_LIMIT_API=120 per minute
WEB_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
MAX_CONTENT_LENGTH=2097152
SESSION_LIFETIME_DAYS=7
# Password reset email delivery
# Leave unset in development and testing; production enables delivery only
# when SMTP settings and a working queue are configured.
# PASSWORD_RESET_EMAILS_ENABLED=true
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=
# Required in production when email is enabled; avoids worker-generated links using a private host.
PASSWORD_RESET_URL_BASE=
PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=3600
# Optional stable HMAC key for worker-only recovery-email lookup. If unset,
# SECRET_KEY is used; keep it stable across deploys and migrations.
# PASSWORD_RESET_LOOKUP_KEY=replace-with-a-separate-long-random-secret
# Separate Redis key namespace for delivery idempotency markers.
PASSWORD_RESET_KEY_PREFIX=cards-password-reset
# Required when email is configured. Defaults to RATELIMIT_STORAGE_URI when unset.
# PASSWORD_RESET_QUEUE_URL=rediss://default:password@redis.example.com:6379/0
PASSWORD_RESET_QUEUE_TIMEOUT_SECONDS=2
PASSWORD_RESET_DELIVERY_TIMEOUT_SECONDS=10
# Email verification and optional two-factor authentication
# EMAIL_VERIFICATION_URL_BASE=https://cards.example.com/verify-email
EMAIL_VERIFICATION_TOKEN_MAX_AGE_SECONDS=86400
# Use a separate, stable 32+ character secret in production to encrypt
# authenticator-app secrets at rest. If omitted, SECRET_KEY is used.
# TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
TWO_FACTOR_EMAIL_CODE_MAX_AGE_SECONDS=600
# Worker retries use 30 seconds, 2 minutes, and 5 minutes; terminal failed jobs
# remain available in Redis for 24 hours for monitoring and recovery.
QUIZ_ATTEMPT_MAX_AGE_SECONDS=7200
MAX_ACTIVE_QUIZ_ATTEMPTS=5
MAX_QUIZ_QUESTIONS=50
